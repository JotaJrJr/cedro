---
// Moldura de iPhone em CSS puro — sem imagem externa. O "notch" cobre a
// mesma área que já vem mascarada (preta) nas capturas de tela reais do
// app, usadas via <slot />.
---

<div class="moldura">
  <div class="notch"></div>
  <div class="tela">
    <slot />
  </div>
  <div class="botao-lateral botao-volume-1"></div>
  <div class="botao-lateral botao-volume-2"></div>
  <div class="botao-lateral botao-power"></div>
</div>

<style>
  .moldura {
    position: relative;
    width: 300px;
    height: 612px;
    background: #0b0f0d;
    border-radius: 52px;
    padding: 14px;
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.35),
      0 0 0 2px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .tela {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--ground);
    border-radius: 38px;
    overflow: hidden;
  }

  .notch {
    position: absolute;
    top: 2.3%;
    left: 50%;
    transform: translateX(-50%);
    width: 38%;
    height: 4.6%;
    background: #0b0f0d;
    border-radius: 999px;
    z-index: 2;
  }

  .botao-lateral {
    position: absolute;
    background: #0b0f0d;
    border-radius: 2px;
  }

  .botao-volume-1,
  .botao-volume-2 {
    left: -3px;
    width: 3px;
    height: 32px;
  }

  .botao-volume-1 {
    top: 130px;
  }

  .botao-volume-2 {
    top: 175px;
  }

  .botao-power {
    right: -3px;
    top: 150px;
    width: 3px;
    height: 60px;
  }

  @media (max-width: 480px) {
    .moldura {
      width: 240px;
      height: 490px;
      border-radius: 42px;
    }

    .tela {
      border-radius: 30px;
    }
  }
</style>
