---
// Prévia ilustrativa da tela "Hoje" do app — não é uma captura de tela.
// Layout e conteúdo de exemplo, fiéis à estrutura real (versículo do dia,
// quiz, resumo da Bíblia/vitral, planta, tira da semana), com os tokens
// reais de cor/tipografia do AppTheme (docs/decisoes/0007 no repo app).
---

<div class="hoje">
  <div class="topo">
    <span class="saudacao">Bom dia</span>
    <div class="icones">
      <span class="icone">⊞</span>
      <span class="icone">⚙</span>
    </div>
  </div>

  <div class="cartao versiculo">
    <span class="rotulo">Versículo do dia</span>
    <p class="texto">"O Senhor é o meu pastor; nada me faltará."</p>
    <span class="ref">Salmos 23:1</span>
  </div>

  <div class="linha">
    <div class="cartao pequeno tira">
      <span class="rotulo">Sua semana</span>
      <div class="dias">
        <span class="dia ativo"></span>
        <span class="dia ativo"></span>
        <span class="dia ativo"></span>
        <span class="dia"></span>
        <span class="dia"></span>
        <span class="dia"></span>
        <span class="dia"></span>
      </div>
    </div>
    <div class="cartao pequeno planta">
      <span class="rotulo">Sua planta</span>
      <span class="planta-emoji">🌱</span>
    </div>
  </div>

  <div class="cartao quiz">
    <span class="rotulo">Quiz do dia</span>
    <p class="pergunta">Quem construiu a arca?</p>
  </div>

  <div class="cartao vitral">
    <span class="rotulo">Sua Bíblia</span>
    <div class="paineis">
      {Array.from({ length: 12 }).map((_, i) => (
        <span class:list={['painel', i < 5 && 'aceso']} />
      ))}
    </div>
  </div>
</div>

<style>
  .hoje {
    padding: 46px 14px 14px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-sans);
  }

  .topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
  }

  .saudacao {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--ink);
  }

  .icones {
    display: flex;
    gap: 8px;
  }

  .icone {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .cartao {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px;
  }

  .rotulo {
    display: block;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }

  .versiculo .texto {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    margin: 0 0 4px;
    color: var(--ink);
  }

  .versiculo .ref {
    font-size: 11px;
    color: var(--green);
  }

  .linha {
    display: flex;
    gap: 10px;
  }

  .linha .cartao {
    flex: 1;
  }

  .dias {
    display: flex;
    gap: 4px;
  }

  .dia {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--surface-alt);
  }

  .dia.ativo {
    background: var(--green);
  }

  .planta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .planta-emoji {
    font-size: 22px;
  }

  .quiz .pergunta {
    font-size: 13px;
    margin: 0;
    color: var(--ink);
  }

  .paineis {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }

  .painel {
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--surface-alt);
  }

  .painel.aceso {
    background: var(--brass);
    opacity: 0.75;
  }
</style>
