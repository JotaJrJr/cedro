---
import Layout from '../layouts/Layout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';

const recursos = [
  {
    titulo: 'Devocional diário',
    texto: 'Uma reflexão curta, uma oração, um passo prático — cinco minutos por dia, sem tom de marketing.',
  },
  {
    titulo: 'Bíblia completa offline',
    texto: 'Leia sem internet, marque capítulos lidos e veja seu progresso acender um vitral, livro por livro.',
  },
  {
    titulo: 'Meditações guiadas em áudio',
    texto: 'Trilhas para ansiedade, paz, gratidão e medo — voz calma, som de ambiente, para ouvir com os olhos fechados.',
  },
  {
    titulo: 'Diário e lista de oração',
    texto: 'Tudo guardado só no seu aparelho. Um espaço seu para registrar como Deus tem falado.',
  },
  {
    titulo: 'Jornadas temáticas',
    texto: '14 dias de conteúdo guiado sobre um tema — cada uma planta uma espécie diferente no seu jardim.',
  },
  {
    titulo: 'Plano de leitura guiado',
    texto: '"Os Evangelhos em 30 dias" e outros planos, com um foco e uma nota curta para cada capítulo.',
  },
];

const duvidas = [
  {
    pergunta: 'O Cedro é gratuito?',
    resposta:
      'Sim. O uso diário é grátis, com um banner discreto. Quem quiser pode assinar o Premium para remover os anúncios e apoiar o projeto.',
  },
  {
    pergunta: 'Preciso de internet para usar?',
    resposta:
      'Não para o essencial — a Bíblia completa funciona offline. Meditações em áudio precisam baixar uma vez.',
  },
  {
    pergunta: 'O conteúdo é revisado por alguém?',
    resposta:
      'Sim. Todo devocional, meditação e plano de leitura passa por revisão teológica antes de entrar no app.',
  },
  {
    pergunta: 'Meus dados (diário, orações) ficam salvos onde?',
    resposta:
      'Só no seu aparelho. Diário, lista de oração, grifos e progresso de leitura nunca saem do seu celular.',
  },
];
---

<Layout
  title="Cedro"
  description="Devocional diário, Bíblia offline, meditações guiadas e jornadas temáticas para ansiedade, paz e gratidão — em português."
>
  <header class="topo">
    <a href="/" class="marca">Cedro</a>
    <nav>
      <a href="#recursos">Recursos</a>
      <a href="/blog">Blog</a>
      <a href="#duvidas">Dúvidas</a>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-wrap">
      <div class="hero-texto">
        <h1>Sua paz, cinco minutos por dia</h1>
        <p class="sub">
          Um companheiro devocional calmo, em português. Versículo do dia,
          devocional curto, Bíblia offline e meditações guiadas — sem
          barulho, sem tom de marketing.
        </p>
        <div class="cta">
          <span class="badge">Em breve na App Store e no Google Play</span>
        </div>
      </div>
      <div class="hero-mockup">
        <PhoneMockup>
          <img src="/screenshots/hoje.png" alt="Tela Hoje do app Cedro" class="screenshot" />
        </PhoneMockup>
      </div>
    </div>
  </section>

  <section id="recursos" class="recursos reveal">
    <div class="wrap-1080">
      <h2>Um lugar para cada parte da caminhada</h2>
      <div class="grade">
        {recursos.map((r) => (
          <article class="cartao">
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mostra reveal">
    <div class="wrap-1080">
      <h2>Por dentro do Cedro</h2>
      <div class="mostra-telas">
        <figure>
          <PhoneMockup>
            <img src="/screenshots/diario.png" alt="Tela de diário e oração do app Cedro" class="screenshot" />
          </PhoneMockup>
          <figcaption>Diário e lista de oração</figcaption>
        </figure>
        <figure>
          <PhoneMockup>
            <img src="/screenshots/biblia.png" alt="Tela de leitura da Bíblia no app Cedro" class="screenshot" />
          </PhoneMockup>
          <figcaption>Bíblia completa, offline</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="jardim reveal">
    <div class="wrap-1080">
      <h2>Seu jardim cresce com você</h2>
      <p class="jardim-sub">
        Cada jornada temática planta uma espécie diferente — acompanhe seu
        crescimento, dia a dia, conforme avança na leitura.
      </p>
      <div class="jardim-fileira-wrap">
        <div class="jardim-fileira">
          {[1, 2, 3, 4, 5, 6].map((n) => (
            <figure class="planta-card">
              <img
                src={`/img/plantas/cedro-${n}.webp`}
                alt={`Cedro — estágio ${n} de 6`}
                class="planta"
              />
              <figcaption>{n}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="verso reveal">
    <div class="verso-bg"></div>
    <div class="wrap-640 verso-conteudo">
      <p class="verso-texto">
        &ldquo;Ele me faz repousar em pastos verdejantes. Guia-me mansamente
        a águas tranquilas.&rdquo;
      </p>
      <p class="verso-ref">Salmos 23:2 · ARC</p>
    </div>
  </section>

  <section class="revisao reveal">
    <div class="wrap-720">
      <p>
        Cada devocional, meditação e plano de leitura do Cedro passa por
        revisão teológica antes de chegar até você. Nada é publicado sem
        alguém conferir se está alinhado à Escritura.
      </p>
    </div>
  </section>

  <section id="duvidas" class="duvidas reveal">
    <div class="wrap-720">
      <h2>Dúvidas</h2>
      <dl>
        {duvidas.map((d) => (
          <div class="item">
            <dt>{d.pergunta}</dt>
            <dd>{d.resposta}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="fechamento reveal">
    <div class="wrap-640">
      <p class="fechamento-texto">
        Sua caminhada com Deus não precisa ser apressada. O Cedro chega em
        breve — cinco minutos por dia, no seu tempo.
      </p>
      <span class="badge">Em breve na App Store e no Google Play</span>
    </div>
  </section>

  <footer>
    <p>
      <a href="/termos">Termos de uso</a>
      &nbsp;·&nbsp;
      <a href="/privacidade">Política de privacidade</a>
      &nbsp;·&nbsp;
      <a href="/blog">Blog</a>
    </p>
    <p class="contato">
      Contato: <a href="mailto:jotapereirajunior@gmail.com">jotapereirajunior@gmail.com</a>
    </p>
  </footer>
</Layout>

<style>
  .topo {
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .marca {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--green);
    text-decoration: none;
  }

  .topo nav {
    display: flex;
    gap: 24px;
  }

  .topo nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .wrap-720,
  .wrap-1080,
  .wrap-640 {
    margin: 0 auto;
    padding: 0 22px;
  }

  .wrap-720 {
    max-width: 720px;
  }

  .wrap-1080 {
    max-width: 1080px;
  }

  .wrap-640 {
    max-width: 640px;
  }

  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/img/hero-fundo.webp');
    background-size: cover;
    background-position: center 65%;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(244, 245, 241, 0.35) 0%, var(--ground) 96%),
      linear-gradient(to top, rgba(244, 245, 241, 0.25) 0%, rgba(244, 245, 241, 0) 40%);
  }

  @media (prefers-color-scheme: dark) {
    .hero-bg {
      filter: brightness(0.42) saturate(0.85);
    }

    .hero-bg::after {
      background:
        linear-gradient(to bottom, rgba(0, 0, 0, 0.1) 0%, var(--ground) 96%),
        linear-gradient(to top, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0) 40%);
    }
  }

  .hero-wrap {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 56px;
    padding-top: 24px;
    padding-bottom: 96px;
    flex-wrap: wrap;
  }

  .hero-texto {
    max-width: 480px;
    text-align: center;
    animation: hero-subir 0.7s ease-out both;
  }

  .hero-mockup {
    animation: hero-subir 0.7s ease-out 0.15s both;
  }

  @keyframes hero-subir {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-texto,
    .hero-mockup {
      animation: none;
    }
  }

  .hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin: 0 0 20px;
  }

  .hero .sub {
    font-size: 18px;
    color: var(--ink-soft);
    margin: 0 0 32px;
  }

  .hero-mockup {
    text-align: center;
  }

  .hero-mockup :global(.screenshot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  @media (min-width: 860px) {
    .hero-wrap {
      text-align: left;
      justify-content: space-between;
    }

    .hero-texto {
      text-align: left;
    }
  }

  .badge {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-soft);
  }

  section {
    padding: 48px 0;
    border-top: 1px solid var(--line);
  }

  section h2 {
    font-size: 24px;
    text-align: center;
    margin: 0 0 32px;
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .cartao {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
  }

  .cartao h3 {
    font-size: 17px;
    margin: 0 0 8px;
  }

  .cartao p {
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0;
  }

  .mostra {
    text-align: center;
  }

  .mostra-telas {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }

  .mostra-telas figure {
    margin: 0;
    --phone-w: 220px;
    --phone-h: 449px;
    --phone-w-sm: 170px;
    --phone-h-sm: 347px;
  }

  .mostra-telas figcaption {
    margin-top: 14px;
    font-size: 15px;
    color: var(--ink-soft);
  }

  .jardim {
    text-align: center;
  }

  .jardim-sub {
    max-width: 480px;
    margin: 0 auto 40px;
    color: var(--ink-soft);
  }

  .jardim-fileira-wrap {
    position: relative;
  }

  .jardim-fileira {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 4px 4px 14px;
  }

  @media (min-width: 860px) {
    .jardim-fileira {
      justify-content: center;
    }
  }

  .planta-card {
    margin: 0;
    flex-shrink: 0;
    scroll-snap-align: start;
    background: #f6f1e7;
    border-radius: 12px;
    padding: 10px 10px 6px;
    box-shadow: 0 6px 16px -8px rgba(29, 43, 36, 0.3);
  }

  .planta-card .planta {
    display: block;
    width: 130px;
    border-radius: 4px;
  }

  .planta-card figcaption {
    margin-top: 4px;
    text-align: center;
    font-size: 12px;
    color: #4a4436;
  }

  .jardim-fileira-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 14px;
    width: 56px;
    background: linear-gradient(to right, transparent, var(--ground) 88%);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .planta-card .planta {
      width: 90px;
    }
  }

  .verso {
    position: relative;
    overflow: hidden;
    text-align: center;
    border-top: none;
    padding: 96px 0;
  }

  .verso-bg {
    position: absolute;
    inset: 0;
    background-image: url('/img/verso-fundo.webp');
    background-size: cover;
    background-position: center 55%;
  }

  .verso-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--ground) 0%, rgba(244, 245, 241, 0.55) 20%, rgba(244, 245, 241, 0.55) 80%, var(--ground) 100%);
  }

  @media (prefers-color-scheme: dark) {
    .verso-bg {
      filter: brightness(0.4) saturate(0.85);
    }

    .verso-bg::after {
      background:
        linear-gradient(to bottom, var(--ground) 0%, rgba(0, 0, 0, 0.15) 20%, rgba(0, 0, 0, 0.15) 80%, var(--ground) 100%);
    }
  }

  .verso-conteudo {
    position: relative;
  }

  .verso-texto {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .verso-ref {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0;
  }

  .revisao {
    text-align: center;
  }

  .revisao p {
    max-width: 480px;
    margin: 0 auto;
    color: var(--ink-soft);
    font-size: 14px;
  }

  dl {
    margin: 0;
  }

  .item {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .item:first-child {
    border-top: none;
  }

  dt {
    font-weight: 600;
    margin-bottom: 6px;
  }

  dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .fechamento {
    text-align: center;
    border-top: none;
    padding: 8px 0 56px;
  }

  .fechamento-texto {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink);
    margin: 0 0 20px;
  }

  footer {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 22px 64px;
    text-align: center;
    font-size: 14px;
    color: var(--ink-soft);
  }

  footer a {
    color: var(--ink-soft);
  }

  .contato {
    margin-top: 12px;
  }
</style>
